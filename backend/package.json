{
  "name": "dentalcare-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + MongoDB API for the DentalCare admin dashboard",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seedDemo.js",
    "seed:demo:reset": "node scripts/seedDemo.js --reset",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  }
}
