# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Put your database name before the "?", e.g. .../dentalcare?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dentalcare?retryWrites=true&w=majority

# Long random string used to sign login tokens (at least 32 characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# How long a login lasts
JWT_EXPIRES_IN=8h

# Allowed website addresses (comma separated). Add your Vercel URL here.
CLIENT_URL=http://localhost:5173

PORT=5000
NODE_ENV=development

# First admin account, created by "npm run seed"
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Optional tuning
# BCRYPT_ROUNDS=12
# LOGIN_RATE_LIMIT=10
